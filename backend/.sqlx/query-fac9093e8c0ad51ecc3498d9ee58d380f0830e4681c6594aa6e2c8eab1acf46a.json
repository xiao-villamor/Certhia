{
  "db_name": "PostgreSQL",
  "query": "SELECT p.name,p.version,c.package_id,c.total FROM package_counts c JOIN packages p ON p.id=c.package_id\n        WHERE c.total>0 AND ($1::bigint IS NULL OR c.total<$1 OR (c.total=$1 AND c.package_id>$2)) AND ($3::text IS NULL OR p.name ILIKE '%'||$3||'%')\n        ORDER BY c.total DESC,c.package_id LIMIT $4",
