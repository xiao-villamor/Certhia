{
  "db_name": "PostgreSQL",
  "query": "SELECT b.id,b.created_at,count(s.id) AS total,count(*) FILTER(WHERE s.status NOT IN ('queued','running')) AS finished,\n        count(*) FILTER(WHERE s.status='failed') AS failed FROM (SELECT * FROM batches WHERE $1::uuid IS NULL OR id<$1 ORDER BY id DESC LIMIT $2)b\n        LEFT JOIN batch_scans bs ON b.id=bs.batch_id LEFT JOIN scan_directory d ON d.id=bs.scan_id LEFT JOIN scans s ON s.id=d.id AND s.queued_at=d.queued_at\n        GROUP BY b.id,b.created_at ORDER BY b.id DESC",
