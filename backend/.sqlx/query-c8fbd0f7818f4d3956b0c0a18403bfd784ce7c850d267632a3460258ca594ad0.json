{
  "db_name": "PostgreSQL",
  "query": "SELECT rd.digest_id,f.package_id,f.advisory_id,f.fixed_in FROM repository_digests rd CROSS JOIN LATERAL (\n        SELECT package_id,advisory_id,fixed_in FROM findings WHERE digest_id=rd.digest_id AND resolved_scan_id IS NULL\n        AND (digest_id,package_id,advisory_id)>($2,$3,$4) ORDER BY package_id,advisory_id LIMIT $5)f\n        WHERE rd.repository_id=$1 AND rd.digest_id>=$2 ORDER BY rd.digest_id,f.package_id,f.advisory_id LIMIT $5",
