{
  "db_name": "PostgreSQL",
  "query": "SELECT a.id,a.external_id,a.summary,s.name AS severity,coalesce(c.affected_images,0) AS \"affected!\"\n        FROM advisories a JOIN severities s ON s.id=a.severity_id LEFT JOIN advisory_counts c ON c.advisory_id=a.id\n        WHERE (external_id,a.id)>($1,$2) AND ($3::text IS NULL OR external_id ILIKE '%'||$3||'%')\n        ORDER BY external_id,a.id LIMIT $4",
