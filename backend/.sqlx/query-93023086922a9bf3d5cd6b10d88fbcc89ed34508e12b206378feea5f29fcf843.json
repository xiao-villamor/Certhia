{
  "db_name": "PostgreSQL",
  "query": "SELECT s.status,s.error,s.started_at,\n        CASE WHEN s.status='queued' THEN 1+(SELECT count(*) FROM scan_jobs q WHERE q.lease_id IS NULL\n            AND (-q.priority,q.queued_at,q.scan_id)<(-s.priority,s.queued_at,s.id)) ELSE 0 END AS \"position!\"\n        FROM scans s JOIN scan_directory d USING(id,queued_at) WHERE d.id=$1",
